  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.60.0",
    "@typescript-eslint/parser": "^8.60.0",
    "eslint": "^10.4.0",
    "globals": "^17.6.0",
    "turbo": "^2.0.0",
    "typescript": "~5.4.0"
  },
  "packageManager": "pnpm@9.0.0"
