{
  "name": "syndicsage",
  "private": true,
  "type": "module",
  "scripts": {
    "dev:web": "pnpm --filter @syndicsage/web dev",
    "dev:api": "pnpm --filter @syndicsage/api dev",
    "dev:worker": "pnpm --filter @syndicsage/worker dev",
    "build:web": "pnpm --filter @syndicsage/web build",
    "typecheck": "pnpm turbo typecheck",
